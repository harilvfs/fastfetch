{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
	"source": "/home/$USER/fastfetch/ascii_art/momo_1.png",
	"position": "top",
        "height":8,
        "width": 19,
        "padding": {
            "top": 1,
            "left": 11,
	    "bottom": 1,
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": " \u001b[90m┌──────────────Hardware──────────────┐"
        },
        {
            "type": "host",
            "key": "   󰌢 ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "   󰑭 ",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "   󰌽 ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "   󰞷 ",
            "keyColor": "yellow"
        },
        {
            "type": "lm",
            "key": "   󰍁 ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "   󱂬 ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "   󰆍 ",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "   ›  OS Age  ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "   ›  Uptime  ",
            "keyColor": "magenta"
        },
        {
            "type": "datetime",
            "key": "   ›  DateTime  ",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": " \u001b[90m└─────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "triangle"
        }
    ]
}
